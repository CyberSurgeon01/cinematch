<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🎬 Movie Recommender</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #0f0f0f;
      color: #f0f0f0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 20px;
    }
    h1 { font-size: 2rem; margin-bottom: 8px; color: #e50914; }
    p.subtitle { color: #aaa; margin-bottom: 30px; font-size: 0.95rem; }
    .card {
      background: #1a1a1a;
      border-radius: 12px;
      padding: 30px;
      width: 100%;
      max-width: 600px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }
    .form-group { margin-bottom: 18px; }
    label { display: block; font-size: 0.85rem; color: #aaa; margin-bottom: 6px; }
    input, select {
      width: 100%;
      padding: 10px 14px;
      border-radius: 8px;
      border: 1px solid #333;
      background: #111;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
      transition: border 0.2s;
    }
    input:focus, select:focus { border-color: #e50914; }
    button {
      width: 100%;
      padding: 12px;
      background: #e50914;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      margin-top: 10px;
      transition: background 0.2s;
    }
    button:hover { background: #c40812; }
    .result {
      margin-top: 30px;
      background: #1a1a1a;
      border-left: 4px solid #e50914;
      border-radius: 12px;
      padding: 25px;
      width: 100%;
      max-width: 600px;
    }
    .result h2 { font-size: 1.5rem; color: #e50914; margin-bottom: 12px; }
    .result .meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 15px;
    }
    .result .meta div {
      background: #111;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 0.85rem;
    }
    .result .meta div span {
      display: block;
      color: #aaa;
      font-size: 0.75rem;
      margin-bottom: 3px;
    }
    .result .overview {
      font-size: 0.9rem;
      color: #ccc;
      line-height: 1.6;
      border-top: 1px solid #333;
      padding-top: 15px;
    }
